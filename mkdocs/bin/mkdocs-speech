#!/usr/bin/env python3
"""Write the speech companion (PAGE.speech.json) of every Markdown page in a directory.

The companion holds what the page says and nothing else. Each page is rendered
with the same Markdown engine and extensions the site is built with, and the
spoken text is read from that rendering: every paragraph, list item and quotation
a reader sees, in order, under the heading that owns it. Nothing is summarised,
paraphrased or invented. Tables, code blocks, diagrams, navigation and buttons
carry no prose and produce no segment, so the sentences around them must say what
they show.

Sections are keyed by the heading ids the site generates. A section is an h2 or
h3 and everything below it up to the next h2 or h3, so text under an h4 or deeper
heading is spoken inside its h2/h3 section, after the deeper heading's own text.
Prose that precedes the first h2/h3 (the lead under the page title) belongs to
the h1 and is keyed by the h1 id. Text before the first heading (a note above the
title, say) is spoken first inside the section of the first heading, as it is read
on the page.

usage: mkdocs-speech [--config mkdocs.yml] DOCS_DIR

The extensions come from the `markdown_extensions` of --config, or of the first
mkdocs.yml found in DOCS_DIR or above it, or default to the set the documentation
sites share (tables, admonition, attr_list, toc, superfences with mermaid).
"""

import argparse
import hashlib
import importlib
import json
import os
import re
import sys
from html.parser import HTMLParser
from pathlib import Path

import markdown

PAUSE = {"p": 400, "li": 300, "blockquote": 400, "dd": 400, "dt": 300, "summary": 400, "title": 500}
PROSE = tuple(k for k in PAUSE if k != "title")
SILENT = ("pre", "table", "svg", "script", "style", "button", "nav", "dialog", "figure")
HEADINGS = ("h1", "h2", "h3", "h4", "h5", "h6")
VOID = ("br", "hr", "img", "input", "meta", "link", "wbr", "area", "col", "source", "track", "embed", "param")
FIGURE_CLASS = re.compile(r"(^|\s)diagram(-links)?(\s|$)")


def sha256_hex(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def default_extensions():
    from pymdownx.superfences import fence_code_format

    names = ["tables", "admonition", "attr_list", "toc", "pymdownx.superfences"]
    configs = {
        "pymdownx.superfences": {
            "custom_fences": [{"name": "mermaid", "class": "mermaid", "format": fence_code_format}]
        }
    }
    return names, configs


def load_extensions(config):
    """The markdown_extensions of a mkdocs.yml, with its python/name tags resolved."""
    import yaml

    class Loader(yaml.SafeLoader):
        pass

    def python_name(loader, suffix, node):
        module, _, attribute = (suffix or loader.construct_scalar(node)).rpartition(".")
        return getattr(importlib.import_module(module), attribute)

    Loader.add_multi_constructor("tag:yaml.org,2002:python/name:", python_name)
    Loader.add_constructor("!ENV", lambda loader, node: None)
    data = yaml.load(config.read_text(encoding="utf-8"), Loader=Loader) or {}
    names, configs = [], {}
    for entry in data.get("markdown_extensions", []):
        if isinstance(entry, str):
            names.append(entry)
        else:
            for name, options in entry.items():
                names.append(name)
                configs[name] = options or {}
    if "toc" not in names:
        names.append("toc")
    # Heading ids do not depend on the permalink; leave its anchor out of the text.
    configs["toc"] = {k: v for k, v in configs.get("toc", {}).items() if k != "permalink"}
    return names, configs


def find_config(directory):
    for folder in [directory, *directory.parents]:
        candidate = folder / "mkdocs.yml"
        if candidate.is_file():
            return candidate
    return None


def tidy(text):
    return re.sub(r"\s+", " ", text).strip()


class Speech(HTMLParser):
    """Spoken segments of one rendered page, keyed by owning heading id, in document order."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.stack = []  # open elements: (tag, silent)
        self.silent = 0
        self.prose = []  # one text buffer per open prose element
        self.kinds = []  # the tag of each open prose element
        self.heading = None  # (level, id, text parts) while inside a heading
        self.owner = None
        self.sections = {}
        self.levels = {}
        self.pending = []  # text met before any heading owns a section

    def _emit(self, text, kind):
        text = tidy(text)
        if not text:
            return
        target = self.sections[self.owner] if self.owner is not None else self.pending
        target.append({"text": text, "pause": PAUSE[kind]})

    def handle_starttag(self, tag, attrs):
        if tag in VOID:
            return
        attrs = dict(attrs)
        silent = tag in SILENT or bool(FIGURE_CLASS.search(attrs.get("class", "")))
        self.stack.append((tag, silent))
        if silent:
            self.silent += 1
            return
        if self.silent:
            return
        if tag in HEADINGS:
            self.heading = (int(tag[1]), attrs.get("id"), [])
        elif tag in PROSE:
            if self.prose:
                self._emit("".join(self.prose[-1]), self.kinds[-1])
                self.prose[-1] = []
            self.prose.append([])
            self.kinds.append(tag)


    def handle_endtag(self, tag):
        if tag in VOID:
            return
        names = [t for t, _ in self.stack]
        if tag not in names:
            return
        while self.stack:
            closed, silent = self.stack.pop()
            if silent:
                self.silent -= 1
            elif not self.silent:
                self._close(closed)
            if closed == tag:
                break

    def _close(self, tag):
        if tag in HEADINGS and self.heading is not None:
            level, ident, parts = self.heading
            self.heading = None
            text = tidy("".join(parts))
            if not text:
                return
            if level <= 3 and ident:
                self.owner = ident
                self.levels[ident] = level
                self.sections.setdefault(ident, [])
                self.sections[ident].extend(self.pending)
                self.pending = []
            self._emit(text + ".", "title")
        elif tag in PROSE and self.prose:
            self._emit("".join(self.prose.pop()), self.kinds.pop())

    def handle_data(self, data):
        if self.silent:
            return
        if self.heading is not None:
            self.heading[2].append(data)
        elif self.prose:
            self.prose[-1].append(data)


def speech_of(rendered):
    parser = Speech()
    parser.feed(rendered)
    parser.close()
    # An h1 with nothing but its own title is not a section a reader can play.
    return {
        key: segments
        for key, segments in parser.sections.items()
        if parser.levels[key] > 1 or len(segments) > 1
    }


def render(path, names, configs):
    engine = markdown.Markdown(extensions=names, extension_configs=configs)
    return engine.convert(path.read_text(encoding="utf-8"))


def main(argv):
    ap = argparse.ArgumentParser(prog="mkdocs-speech", description=__doc__.split("\n\n")[0])
    ap.add_argument("docs_dir")
    ap.add_argument("--config", help="mkdocs.yml whose markdown_extensions render the pages")
    args = ap.parse_args(argv)
    directory = Path(args.docs_dir).resolve()
    config = Path(args.config).resolve() if args.config else find_config(directory)
    names, configs = load_extensions(config) if config else default_extensions()
    if config:
        # Extensions such as snippets resolve relative paths from the config's folder, as mkdocs does.
        os.chdir(config.parent)
    for page in sorted(p for p in directory.rglob("*.md") if p.is_file()):
        sections = speech_of(render(page, names, configs))
        if not sections:
            continue
        sections["_source"] = {"file": page.name, "sha256": sha256_hex(page)}
        out = page.with_suffix(".speech.json")
        out.write_text(json.dumps(sections, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        print(f"  {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
